{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.0/tooling/cli/schema.json",
  "identifier": "default",
  "description": "Default permissions for InFlow application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "any-url-or-path",
          "path": "**"
        }
      ]
    },
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-cmd",
          "cmd": "cmd.exe",
          "args": true
        },
        {
          "name": "run-ps",
          "cmd": "powershell.exe",
          "args": true
        },
        {
          "name": "run-explorer",
          "cmd": "explorer",
          "args": true
        },
        {
          "name": "run-explorer-exe",
          "cmd": "explorer.exe",
          "args": true
        },
        {
          "name": "run-start",
          "cmd": "start",
          "args": true
        }
      ]
    },
    "store:default",
    "dialog:default"
  ]
}
