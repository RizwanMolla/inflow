{
  "expo": {
    "name": "InFlow Mobile",
    "slug": "inflow-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0c0e",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow InFlow to scan the desktop QR code for pairing."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0e",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rizwan711410.inflowmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "68c839bc-ec52-4a95-874a-b6ce693e9038"
      }
    }
  }
}
